{
  "mcpServers": {
    "gsd-workflow": {
      "command": "node",
      "args": [
        "__GSD_MCP_SERVER_CLI__"
      ],
      "cwd": "__PROJECT_ROOT__",
      "env": {
        "GSD_CLI_PATH": "__GSD_CLI_PATH__",
        "GSD_WORKFLOW_EXECUTORS_MODULE": "__GSD_EXTENSIONS__/tools/workflow-tool-executors.js",
        "GSD_WORKFLOW_WRITE_GATE_MODULE": "__GSD_EXTENSIONS__/bootstrap/write-gate.js",
        "GSD_PERSIST_WRITE_GATE_STATE": "1",
        "GSD_WORKFLOW_PROJECT_ROOT": "__PROJECT_ROOT__"
      }
    }
  }
}
