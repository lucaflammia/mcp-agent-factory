{"id": "ext-001", "input": {"task": "Extract all KPIs from the Q3 2024 report", "constraints": {"required_fields": ["revenue", "gross_margin", "ebitda", "cac", "nps", "operating_cash_flow", "arr_growth"]}}, "expected": {"revenue": "USD 52.4M", "gross_margin": "42.3%", "ebitda": "USD 10.1M", "cac": "USD 1,240", "nps": 74, "operating_cash_flow": "USD 7.6M", "arr_growth": "22%"}, "category": "structured_extraction", "notes": "All seven KPIs must be present with correct values"}
