{
  "title": "RAG Pipeline \u2014 Metrics & Quality Gates",
  "uid": "rag-metrics",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "datasource": "Prometheus",
        "definition": "label_values(rag_generation_total, job)",
        "allValue": null,
        "includeAll": false,
        "query": "label_values(rag_generation_total, job)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Retrieval Recall@1",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_retrieval_recall_1",
          "legendFormat": "Recall@1"
        }
      ]
    },
    {
      "id": 2,
      "title": "Retrieval Score Gap (p1 - p2)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg(rag_retrieval_mrr{job=\"rag_eval\"})",
          "legendFormat": "{{owner_id}}"
        }
      ],
      "alert": {
        "message": "Score gap < 0.1 indicates weak disambiguation",
        "alertThreshold": 0.1
      }
    },
    {
      "id": 3,
      "title": "Empty Result Rate (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum(increase(rag_generation_refusal_total{reason=\"empty_retrieval\"}[5m])) / sum(increase(rag_generation_total[5m]))",
          "legendFormat": "{{owner_id}}"
        }
      ],
      "alert": {
        "message": "Empty results > 10% indicates coverage gap",
        "alertThreshold": 10
      }
    },
    {
      "id": 4,
      "title": "Refusal Rate (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum(increase(rag_generation_refusal_total[5m])) / sum(increase(rag_generation_total[5m]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0.3
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "1m",
                "now"
              ]
            },
            "reducer": {
              "type": "last"
            },
            "type": "query"
          }
        ],
        "frequency": "5m",
        "handler": 1,
        "message": "Refusal rate > 30% indicates possible data loss or access restriction",
        "name": "RAG refusal spike alert",
        "noDataState": "no_data",
        "for": "5m",
        "executionErrorState": "alerting"
      }
    },
    {
      "id": 5,
      "title": "MRR (Mean Reciprocal Rank)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg(rag_retrieval_mrr{job=\"rag_eval\"})",
          "legendFormat": "{{owner_id}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "nDCG@10",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg(rag_retrieval_ndcg_10{job=\"rag_eval\"})",
          "legendFormat": "{{owner_id}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Eval Golden Set Version",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_eval_golden_set_version",
          "legendFormat": "Golden set version"
        }
      ]
    },
    {
      "id": 8,
      "title": "Last Eval Run",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "time() - rag_eval_last_run_timestamp_seconds",
          "legendFormat": "Seconds ago"
        }
      ]
    },
    {
      "id": 9,
      "title": "Baseline Pass Rate (%) vs Current",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_eval_baseline_pass_rate * 100",
          "legendFormat": "Baseline"
        },
        {
          "datasource": "Prometheus",
          "expr": "rag_eval_current_pass_rate * 100",
          "legendFormat": "Current"
        }
      ],
      "alert": {
        "message": "Pass rate regression > 5%",
        "alertThreshold": -5
      }
    },
    {
      "id": 10,
      "title": "Index Size & Chunk Count",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_index_chunk_count",
          "legendFormat": "Chunk Count",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Similarity Score Distribution",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(rag_retrieval_score_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.75, sum(rate(rag_retrieval_score_bucket[5m])) by (le))",
          "legendFormat": "p75",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.90, sum(rate(rag_retrieval_score_bucket[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "C"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_score_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "D"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Top-1 Similarity Score Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_top1_score",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Score Heatmap (percentile \u00d7 time)",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(rag_retrieval_score_bucket[5m])) by (le)",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "short",
          "decimals": 2
        },
        "color": {
          "scheme": "Spectral",
          "fill": "dark-orange",
          "scale": "linear",
          "steps": 64
        },
        "legend": {
          "show": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Vector Cluster View (2D UMAP)",
      "type": "xychart",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://gateway:8000/rag/visualize?q=test&tenant=default&k=10&flat=1",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "points",
          "columns": [
            {
              "selector": "x",
              "text": "x",
              "type": "number"
            },
            {
              "selector": "y",
              "text": "y",
              "type": "number"
            },
            {
              "selector": "label",
              "text": "label",
              "type": "string"
            },
            {
              "selector": "score",
              "text": "score",
              "type": "number"
            },
            {
              "selector": "kind",
              "text": "kind",
              "type": "string"
            }
          ],
          "filters": [],
          "format": "table",
          "parser": "backend",
          "computed_columns": []
        }
      ],
      "options": {
        "seriesMapping": "auto",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "dims": {
          "x": "x",
          "y": "y",
          "frame": 0
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "pointSize": {
              "fixed": 8
            },
            "show": "points"
          }
        },
        "overrides": []
      },
      "description": "2D UMAP projection of query (highlighted) vs top-k results vs background chunks. Requires Infinity datasource plugin and a seeded index. Change the 'q' param in the target URL to match your query."
    }
  ]
}