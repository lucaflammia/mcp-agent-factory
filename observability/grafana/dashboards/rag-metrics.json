{
  "title": "RAG Pipeline — Metrics & Quality Gates",
  "uid": "rag-metrics",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "datasource": "Prometheus",
        "definition": "label_values(rag_retrieval_recall_1, owner_id)",
        "allValue": null,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Retrieval Recall@1 (Top-1 Score Distribution)",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(rag_retrieval_recall_1_bucket{owner_id=~\"$tenant_id\"}[5m])) by (le))",
          "legendFormat": "P99"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(rag_retrieval_recall_1_bucket{owner_id=~\"$tenant_id\"}[5m])) by (le))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "id": 2,
      "title": "Retrieval Score Gap (p1 - p2)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg(rag_retrieval_score_gap{owner_id=~\"$tenant_id\"}) by (owner_id)",
          "legendFormat": "{{owner_id}}"
        }
      ],
      "alert": {
        "message": "Score gap < 0.1 indicates weak disambiguation",
        "alertThreshold": 0.1
      }
    },
    {
      "id": 3,
      "title": "Empty Result Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum(rate(rag_query_empty_results_total{owner_id=~\"$tenant_id\"}[5m])) by (owner_id) / sum(rate(rag_query_total{owner_id=~\"$tenant_id\"}[5m])) by (owner_id)",
          "legendFormat": "{{owner_id}}"
        }
      ],
      "alert": {
        "message": "Empty results > 10% indicates coverage gap",
        "alertThreshold": 10
      }
    },
    {
      "id": 4,
      "title": "Refusal Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum(rate(rag_generation_refusal_total{owner_id=~\"$tenant_id\"}[5m])) by (owner_id) / sum(rate(rag_generation_total{owner_id=~\"$tenant_id\"}[5m])) by (owner_id)",
          "legendFormat": "{{owner_id}}"
        }
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [0.3] },
            "operator": { "type": "and" },
            "query": { "params": ["A", "1m", "now"] },
            "reducer": { "type": "last" },
            "type": "query"
          }
        ],
        "frequency": "5m",
        "handler": 1,
        "message": "Refusal rate > 30% indicates possible data loss or access restriction",
        "name": "RAG refusal spike alert",
        "noDataState": "no_data",
        "for": "5m",
        "executionErrorState": "alerting"
      }
    },
    {
      "id": 5,
      "title": "MRR (Mean Reciprocal Rank)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg(rag_retrieval_mrr{owner_id=~\"$tenant_id\"}) by (owner_id)",
          "legendFormat": "{{owner_id}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "nDCG@10",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg(rag_retrieval_ndcg_10{owner_id=~\"$tenant_id\"}) by (owner_id)",
          "legendFormat": "{{owner_id}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Eval Golden Set Version",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_eval_golden_set_version",
          "legendFormat": "Golden set version"
        }
      ]
    },
    {
      "id": 8,
      "title": "Last Eval Run",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "time() - rag_eval_last_run_timestamp_seconds",
          "legendFormat": "Seconds ago"
        }
      ]
    },
    {
      "id": 9,
      "title": "Baseline Pass Rate (%) vs Current",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_eval_baseline_pass_rate * 100",
          "legendFormat": "Baseline"
        },
        {
          "datasource": "Prometheus",
          "expr": "rag_eval_current_pass_rate * 100",
          "legendFormat": "Current"
        }
      ],
      "alert": {
        "message": "Pass rate regression > 5%",
        "alertThreshold": -5
      }
    },
    {
      "id": 10,
      "title": "Index Size & Chunk Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_index_chunk_count{owner_id=~\"$tenant_id\"}",
          "legendFormat": "Chunks {{owner_id}}"
        }
      ]
    }
  ]
}
